# 复制为 .env 后再执行 docker compose up -d --build
# cp .env.docker.example .env   (Linux/macOS)
# copy .env.docker.example .env (Windows)

# 至少 32 字符，生产环境务必修改
JWT_SECRET=change-this-secret-before-production-min-32-chars

# 浏览器访问地址，需与 compose 里 web 端口一致
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080

SEED_ON_STARTUP=true
AUTO_CREATE_TABLES=true
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
OPERATION_LOG_RETENTION_DAYS=180

# --- 数据库（二选一）---

# 默认：SQLite，数据保存在 Docker 卷 appdata 中
DATABASE_URL=sqlite:////data/app.db

# PostgreSQL：取消下面三行注释，并注释掉上面的 DATABASE_URL
# COMPOSE_PROFILES=postgres
# DATABASE_URL=postgresql+psycopg://python_admin:python_admin@postgres:5432/python_admin
# POSTGRES_USER=python_admin
# POSTGRES_PASSWORD=python_admin
# POSTGRES_DB=python_admin
